# build output
/dist/
*.deb
*.rpm
*.test
*.out
coverage.*
/limdm
/limdm-agent
/limdm-desktop
/limdm-server

# secrets and keys, never commit
*.key
*.pem
server.env
.env
release.key

# local tooling
.claude/settings.local.json
.pixi/

# tool data
/.claude/

# public osquery repository signing key, embedded into the agent (not a secret)
!internal/api/osquery.asc

# public signing keys of vendor package repositories (seed catalog)
!internal/server/vendorkeys/*.asc
