# /etc/limdm-server/server.env (mode 0600)
LIMDM_DATABASE_URL=postgres://limdm@db.example.com/limdm?sslmode=verify-full
LIMDM_PUBLIC_URL=https://mdm.example.com
LIMDM_TLS_CERT=/etc/limdm-server/tls.crt
LIMDM_TLS_KEY=/etc/limdm-server/tls.key
LIMDM_AGENT_URL=https://mdm.example.com:8444
LIMDM_AGENT_LISTEN=:8444
LIMDM_OIDC_ISSUER=https://accounts.google.com
LIMDM_OIDC_CLIENT_ID=
LIMDM_OIDC_CLIENT_SECRET=
LIMDM_OIDC_ALLOWED_DOMAIN=example.com
LIMDM_ADMINS=admin@example.com
LIMDM_AUDITORS=isb@example.com
# openssl rand -hex 32
LIMDM_SESSION_KEY=
LIMDM_RELEASE_DIR=/var/lib/limdm-server/releases
LIMDM_STALE_HOURS=24
