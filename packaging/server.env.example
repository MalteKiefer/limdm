# /etc/limdm-server/server.env (root:limdm 0640)
# Local PostgreSQL via unix socket and peer auth (role "limdm"):
#   LIMDM_DATABASE_URL=postgres:///limdm?host=/var/run/postgresql
LIMDM_DATABASE_URL=postgres://limdm@db.example.com/limdm?sslmode=verify-full
LIMDM_PUBLIC_URL=https://mdm.example.com
# key readable by the service user: chown root:limdm, chmod 0640
LIMDM_TLS_CERT=/etc/limdm-server/tls.crt
LIMDM_TLS_KEY=/etc/limdm-server/tls.key
LIMDM_AGENT_URL=https://mdm.example.com:8444
LIMDM_AGENT_LISTEN=:8444
# extra names or IPs in the agent certificate (comma separated), e.g. when moving to a domain
LIMDM_AGENT_HOSTS=
# OIDC is optional; leave LIMDM_OIDC_ISSUER empty to use local admins only.
LIMDM_OIDC_ISSUER=https://accounts.google.com
LIMDM_OIDC_CLIENT_ID=
LIMDM_OIDC_CLIENT_SECRET=
LIMDM_OIDC_ALLOWED_DOMAIN=example.com
LIMDM_ADMINS=admin@example.com
LIMDM_AUDITORS=isb@example.com
# Local admins (password + TOTP) as fallback, managed with `limdm-server local-admin`.
LIMDM_LOCAL_LOGIN=false
# openssl rand -hex 32
LIMDM_SESSION_KEY=
LIMDM_RELEASE_DIR=/var/lib/limdm-server/releases
LIMDM_STALE_HOURS=24
