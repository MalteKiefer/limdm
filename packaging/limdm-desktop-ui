def logo_image(path, size):
    """The company logo when IT set one, otherwise the LiMDM logo."""
    if path and os.path.isfile(path):
        img = Gtk.Image.new_from_file(path)
    else:
        img = Gtk.Image(icon_name="limdm")
    img.set_pixel_size(size)
    return img


class Window(Adw.ApplicationWindow):
    def __init__(self, app, start):
        super().__init__(application=app, title="LiMDM", default_width=900, default_height=640)
        self.info = {}
        self.toasts = Adw.ToastOverlay()
        self.split = Adw.NavigationSplitView(min_sidebar_width=220, max_sidebar_width=260)
        self.toasts.set_child(self.split)
        self.set_content(self.toasts)

        # sidebar: company and pages with icons, like GNOME Settings
        side = Adw.ToolbarView()
        self.side_header = Adw.HeaderBar()
        self.side_title = Adw.WindowTitle(title="LiMDM")
        self.side_header.set_title_widget(self.side_title)
        self.logo = Gtk.Box()
        self.side_header.pack_start(self.logo)
        self.cfg = load_config()
        self.scheme = Gtk.Button(css_classes=["flat"])
        self.scheme.connect("clicked", self._cycle_scheme)
        self.side_header.pack_end(self.scheme)
        self._apply_scheme(self.cfg.get("scheme", "system"))
        self.log_problems_only = False
        side.add_top_bar(self.side_header)
        self.nav = Gtk.ListBox(css_classes=["navigation-sidebar"])
        for key, icon, label in PAGES:
            row = Gtk.ListBoxRow()
            row.key = key
            box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=label, xalign=0))
            row.set_child(box)
            self.nav.append(row)
        self.nav.connect("row-activated", lambda _l, row: self.show(row.key))
        side.set_content(Gtk.ScrolledWindow(child=self.nav, vexpand=True))
        self.split.set_sidebar(Adw.NavigationPage(title="LiMDM", child=side))

        # content: header with refresh, preferences page per section
        self.content = Adw.ToolbarView()
        self.header = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text=_("Refresh"))
        refresh.connect("clicked", lambda _b: self.refresh())
        self.header.pack_end(refresh)
        self.content.add_top_bar(self.header)
        self.page = Adw.NavigationPage(title="", child=self.content)
        self.split.set_content(self.page)

        start = {"profiles": "blueprint"}.get(start, start)  # page name before 0.19
        self.current = start if any(p[0] == start for p in PAGES) else "overview"
        self.shown = None  # the info the current page was built from
        self.logo_path = False
        self.refresh()
        GLib.timeout_add_seconds(60, self._tick)

    def _tick(self):
        self.refresh()
        return True

    # ---- data ----

    def refresh(self):
        in_background(lambda: agent({"op": "info"}, timeout=20), self._loaded)

    def _loaded(self, res, err):
        if err or not res or res.get("error") and not res.get("status"):
            self.info = {"error": str(err or tr_data(res.get("error")) or _("no answer"))}
        else:
            self.info = res
        company = self.info.get("company") or "LiMDM"
        self.side_title.set_title(company)
        if self.logo_path != self.info.get("logo"):
            self.logo_path = self.info.get("logo")
            child = self.logo.get_first_child()
            if child:
                self.logo.remove(child)
            self.logo.append(logo_image(self.logo_path, 24))
        self.side_title.set_subtitle(_("Managed device"))
        # Rebuild the page only when its data changed and the user does not
        # work in it; the software page loads its own data.
        if self.shown is None or (self.current != "software" and self.info != self.shown and not self._holds_input()):
            self.show(self.current)
        return False

    def _holds_input(self):
        """True while the user types in the page or left text in a field that
        is not sent yet (a disk passphrase). A refresh then keeps the page."""
        page = self.content.get_content()
        if page is None:
            return False
        focus = self.get_focus()
        if isinstance(focus, Gtk.Editable) and focus.is_ancestor(page):
            return True
        todo = [page]
        while todo:
            w = todo.pop()
            if isinstance(w, Gtk.SearchEntry):
                continue  # the software search is kept across rebuilds
            if isinstance(w, Gtk.Editable) and w.get_text():
                return True
            c = w.get_first_child()
            while c is not None:
                todo.append(c)
                c = c.get_next_sibling()
        return False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    # ---- pages ----

    def show(self, key):
        self.current, self.shown = key, self.info
        for i, p in enumerate(PAGES):
            if p[0] == key:
                self.nav.select_row(self.nav.get_row_at_index(i))
                self.page.set_title(p[2])
        build = getattr(self, "page_" + key)
        self.content.set_content(build())
        self.split.set_show_content(True)

    def _unreachable(self):
        page = Adw.StatusPage(icon_name="network-offline-symbolic", title=_("Agent Not Reachable"),
                              description=_("The LiMDM agent on this device does not respond. IT has been informed when it comes back.") + "\n" + self.info.get("error", ""))
        return page

    def page_overview(self):
        st = self.info.get("status")
        if not st:
            return self._unreachable()
        failing = st.get("failing") or []
        if st.get("locked"):
            icon, title, desc, css = "system-lock-screen-symbolic", _("Device Locked"), \
                _("IT locked this device."), "error"
        elif st.get("last_error"):
            icon, title, desc, css = "network-offline-symbolic", _("No Connection to the Server"), \
                st["last_error"], "warning"
        elif failing:
            icon, title, css = "dialog-warning-symbolic", _("Action Needed"), "warning"
            desc = ngettext("%d check failing", "%d checks failing", len(failing)) % len(failing)
        else:
            icon, title, desc, css = "object-select-symbolic", _("Device Is Compliant"), \
                _("All checks passed."), "success"
        page = Adw.PreferencesPage()
        status = Adw.StatusPage(icon_name=icon, title=title, description=desc, css_classes=["compact"])
        status.add_css_class(css)
        top = Adw.PreferencesGroup()
        top.add(status)
        page.add(top)

        dev = Adw.PreferencesGroup(title=_("Device"))
        dev.add(self._row(_("Name"), st.get("hostname", ""), "computer-symbolic"))
        dev.add(self._row(_("Managed by"), self.info.get("company", ""), "system-users-symbolic"))
        sync = Gtk.Button(label=_("Sync Now"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        sync.connect("clicked", self._sync)
        last = self._row(_("Last sync"), when(st.get("last_checkin")), "emblem-synchronizing-symbolic")
        last.add_suffix(sync)
        dev.add(last)
        page.add(dev)

        if self.info.get("need"):
            g = Adw.PreferencesGroup(title=_("Needs Your Attention"))
            row = Adw.ActionRow(title=_("Disk recovery key missing"),
                                subtitle=_("IT needs a recovery key for your encrypted disk."),
                                activatable=True)
            row.add_prefix(Gtk.Image(icon_name="drive-harddisk-system-symbolic"))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r: self.show("disk"))
            g.add(row)
            page.add(g)
        return page

    def page_compliance(self):
        st = self.info.get("status")
        if not st:
            return self._unreachable()
        page = Adw.PreferencesPage()
        checks = st.get("check_list") or []
        order = {"fail": 0, "excepted": 1, "na": 2, "pass": 3}
        checks.sort(key=lambda c: (order.get(c.get("status"), 4), tr_data(c.get("title", ""))))
        groups = {}
        names = {"fail": _("Failing"), "excepted": _("Exceptions"),
                 "na": _("Not applicable"), "pass": _("Passed")}
        icons = {"fail": ("dialog-warning-symbolic", "warning"), "pass": ("object-select-symbolic", "success"),
                 "excepted": ("action-unavailable-symbolic", "dim-label"), "na": ("action-unavailable-symbolic", "dim-label")}
        for c in checks:
            s = c.get("status", "na")
            g = groups.get(s)
            if g is None:
                g = groups[s] = Adw.PreferencesGroup(title=names.get(s, s))
                page.add(g)
            row = Adw.ActionRow(title=GLib.markup_escape_text(tr_data(c.get("title", ""))),
                                subtitle=GLib.markup_escape_text(c.get("detail", "")), subtitle_lines=3)
            icon, css = icons.get(s, icons["na"])
            img = Gtk.Image(icon_name=icon)
            img.add_css_class(css)
            row.add_prefix(img)
            g.add(row)
        if not checks:
            g = Adw.PreferencesGroup()
            g.add(Adw.StatusPage(icon_name="security-high-symbolic", title=_("No Checks Yet"),
                                 css_classes=["compact"]))
            page.add(g)
        return page

    def page_disk(self):
        st = self.info.get("status")
        if not st:
            return self._unreachable()
        page = Adw.PreferencesPage()
        need = self.info.get("need") or []
        if not need:
            g = Adw.PreferencesGroup()
            g.add(Adw.StatusPage(icon_name="channel-secure-symbolic", title=_("Recovery Keys Stored"),
                                 description=ngettext("%d disk recovery key is stored with IT. Nothing to do.",
                                                     "%d disk recovery keys are stored with IT. Nothing to do.", st.get("escrowed", 0)) % st.get("escrowed", 0),
                                 css_classes=["compact"]))
            page.add(g)
            return page
        for vol in need:
            g = Adw.PreferencesGroup(title=vol.get("device", ""),
                                     description=_("IT needs a recovery key for this encrypted disk, so access can be restored if the passphrase is ever lost. Enter the passphrase you type when the computer starts; it stays unchanged."))
            entry = Adw.PasswordEntryRow(title=_("Disk passphrase"))
            button = Gtk.Button(label=_("Store Key"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
            button.connect("clicked", self._escrow, vol.get("uuid"), entry)
            entry.connect("entry-activated", lambda e, b=button: b.emit("clicked"))
            entry.add_suffix(button)
            g.add(entry)
            page.add(g)
        return page

    def page_log(self):
        page = Adw.PreferencesPage()
        lines = self.info.get("log_lines") or []
        only = Gtk.Switch(active=self.log_problems_only, valign=Gtk.Align.CENTER)
        only.connect("notify::active", self._log_filter)
        head = Gtk.Box(spacing=8)
        head.append(Gtk.Label(label=_("Only warnings and errors"), css_classes=["dim-label"]))
        head.append(only)
        g = Adw.PreferencesGroup(title=_("Agent Log"),
                                 description=_("Latest entries of the agent and its watchdog, newest first."),
                                 header_suffix=head)
        icons = {"error": ("dialog-error-symbolic", "error"), "warning": ("dialog-warning-symbolic", "warning"),
                 "info": ("dialog-information-symbolic", "dim-label")}
        shown = 0
        for ln in reversed(lines):
            level = ln.get("level", "info")
            if self.log_problems_only and level == "info":
                continue
            row = Adw.ActionRow(title=GLib.markup_escape_text(ln.get("text", "")), subtitle=when(ln.get("time")), title_lines=4)
            icon, css = icons.get(level, icons["info"])
            img = Gtk.Image(icon_name=icon)
            img.add_css_class(css)
            row.add_prefix(img)
            g.add(row)
            shown += 1
        if not shown:
            g.add(Adw.StatusPage(icon_name="object-select-symbolic", title=_("Nothing Recorded"), css_classes=["compact"]))
        page.add(g)
        return page

    def _log_filter(self, switch, _param):
        self.log_problems_only = switch.get_active()
        self.show("log")

