    def _row(self, title, value, icon, selectable=False):
        row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(value or "–"),
                            css_classes=["property"], subtitle_selectable=selectable)
        if icon:
            row.add_prefix(Gtk.Image(icon_name=icon))
        return row

    def _apply_scheme(self, name):
        if name not in SCHEMES:
            name = "system"
        scheme, icon, tip = SCHEMES[name]
        Adw.StyleManager.get_default().set_color_scheme(scheme)
        self.scheme.set_icon_name(icon)
        self.scheme.set_tooltip_text(tip)
        self.cfg["scheme"] = name

    def _cycle_scheme(self, _button):
        order = ["system", "dark", "light"]
        cur = self.cfg.get("scheme", "system")
        self._apply_scheme(order[(order.index(cur) + 1) % 3 if cur in order else 0])
        save_config(self.cfg)

    # ---- software ----

    def page_software(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.sw_box = box
        if not hasattr(self, "sw_query"):
            self.sw_query, self.sw_category = "", ""
        self._load_catalog()
        return box

    def _load_catalog(self):
        in_background(lambda: agent({"op": "catalog"}, timeout=20), self._catalog_loaded)

    def _catalog_loaded(self, res, err):
        if self.current != "software":
            return False
        if self._holds_input():  # typing in the search: try again shortly
            GLib.timeout_add_seconds(3, lambda: (self._load_catalog(), False)[1])
            return False
        box = self.sw_box
        while box.get_first_child():
            box.remove(box.get_first_child())
        if err or not res or not res.get("ok"):
            box.append(self._unreachable())
            return False
        apps = res.get("apps") or []
        store = res.get("store") or {}
        if store.get("read_only"):
            box.append(Adw.Banner(title=_("Software is installed through this catalog. Other app stores are read only."), revealed=True))
        bar = Gtk.Box(spacing=12, margin_top=18, margin_bottom=6, margin_start=24, margin_end=24)
        search = Gtk.SearchEntry(placeholder_text=_("Search apps"), hexpand=True, text=self.sw_query)
        cats = [_("All categories")] + sorted({a.get("category") for a in apps if a.get("category")})
        drop = Gtk.DropDown.new_from_strings(cats)
        if self.sw_category in cats:
            drop.set_selected(cats.index(self.sw_category))
        bar.append(search)
        bar.append(drop)
        other = Gtk.Button(icon_name="list-add-symbolic", tooltip_text=_("Request another app"))
        other.connect("clicked", lambda _b: self._other_app_dialog())
        bar.append(other)
        box.append(bar)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=4, min_children_per_line=1,
                           row_spacing=12, column_spacing=12, margin_top=12, margin_bottom=24, margin_start=24, margin_end=24,
                           valign=Gtk.Align.START)
        for app in apps:
            card = self._app_card(app)
            card.app = app
            flow.append(card)

        def matches(child):
            a = child.get_child().app
            q = self.sw_query.lower()
            cat_ok = drop.get_selected() == 0 or a.get("category") == cats[drop.get_selected()]
            return cat_ok and (not q or q in (a.get("name", "") + " " + a.get("summary", "") + " " + a.get("category", "")).lower())

        flow.set_filter_func(matches)

        def on_search(entry):
            self.sw_query = entry.get_text()
            flow.invalidate_filter()

        def on_category(d, _p):
            self.sw_category = cats[d.get_selected()]
            flow.invalidate_filter()

        search.connect("search-changed", on_search)
        drop.connect("notify::selected", on_category)
        if not apps:
            box.append(Adw.StatusPage(icon_name="system-software-install-symbolic", title=_("No Apps Yet"),
                                      description=_("IT has not published any apps for this device.")))
        else:
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            content.append(flow)
            mine = self._my_requests(res.get("requests") or [])
            if mine:
                content.append(mine)
            box.append(Gtk.ScrolledWindow(child=content, vexpand=True))
        if any(a.get("busy") for a in apps):
            GLib.timeout_add_seconds(3, lambda: (self._load_catalog(), False)[1])
        return False

    def _app_icon(self, app):
        if app.get("icon") and os.path.isfile(app["icon"]):
            img = Gtk.Image.new_from_file(app["icon"])
        else:
            theme = Gtk.IconTheme.get_for_display(self.get_display())
            name = "application-x-executable"
            for src in app.get("sources") or []:
                if src.get("flatpak") and theme.has_icon(src["flatpak"]):
                    name = src["flatpak"]
            img = Gtk.Image(icon_name=name)
        img.set_pixel_size(64)
        return img

    def _app_card(self, app):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["card"], width_request=190)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=16, margin_bottom=14, margin_start=14, margin_end=14)
        inner.append(self._app_icon(app))
        inner.append(Gtk.Label(label=app.get("name", ""), css_classes=["heading"], ellipsize=Pango.EllipsizeMode.END))
        summary = Gtk.Label(label=app.get("summary", ""), css_classes=["dim-label", "caption"], wrap=True, lines=2,
                            ellipsize=Pango.EllipsizeMode.END, justify=Gtk.Justification.CENTER, max_width_chars=24)
        inner.append(summary)
        inner.append(self._app_action(app))
        if app.get("error"):
            inner.append(Gtk.Label(label=tr_data(app["error"]), css_classes=["error", "caption"], wrap=True, max_width_chars=24))
        card.append(inner)
        return card

    def _app_action(self, app):
        mode, busy = app.get("mode"), app.get("busy")
        if busy:
            b = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
            b.append(Gtk.Spinner(spinning=True))
            b.append(Gtk.Label(label=_("Installing…") if busy == "install" else _("Removing…")))
            return b
        if app.get("installed"):
            b = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
            flatpak = next((x.get("flatpak") for x in app.get("sources") or [] if x.get("kind") == "flatpak"), "")
            if app.get("via") == "flatpak" and flatpak:
                o = Gtk.Button(label=_("Open"), css_classes=["suggested-action", "pill"])
                o.connect("clicked", lambda _b: Gio.Subprocess.new(["flatpak", "run", flatpak], Gio.SubprocessFlags.NONE))
                b.append(o)
            else:
                b.append(Gtk.Label(label=_("Installed"), css_classes=["success"]))
            if mode == "available":
                r = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text=_("Remove"), css_classes=["flat", "circular"])
                r.connect("clicked", lambda _b: self._app_op("app-remove", app))
                b.append(r)
            return b
        if mode == "required":
            return Gtk.Label(label=_("Installed by IT soon"), css_classes=["dim-label"])
        if mode == "request" and app.get("request") != "approved":
            if app.get("request") == "pending":
                return Gtk.Label(label=_("Requested"), css_classes=["dim-label"])
            label = _("Request Again") if app.get("request") == "denied" else _("Request")
            q = Gtk.Button(label=label, css_classes=["pill"], halign=Gtk.Align.CENTER)
            q.connect("clicked", lambda _b: self._request_dialog(app))
            return q
        i = Gtk.Button(label=_("Install"), css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER)
        i.connect("clicked", lambda _b: self._app_op("app-install", app))
        return i

    def _app_op(self, op, app, note=""):
        def done(res, err):
            if err or not res.get("ok"):
                self.toast(tr_data((res or {}).get("error")) or str(err))
            elif op == "app-request":
                self.toast(_("Request sent to IT"))
            self._load_catalog()
            return False

        in_background(lambda: agent({"op": op, "app": app.get("id"), "note": note}, timeout=20), done)

    def _request_dialog(self, app):
        dlg = Adw.MessageDialog(transient_for=self, heading=_("Request %s") % app.get("name", ""),
                                body=_("IT decides on your request: either you may install the app, or it is installed for you."))
        entry = Gtk.Entry(placeholder_text=_("Why do you need it? (optional)"))
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", _("Cancel"))
        dlg.add_response("send", _("Send Request"))
        dlg.set_response_appearance("send", Adw.ResponseAppearance.SUGGESTED)
        dlg.connect("response", lambda d, r: self._app_op("app-request", app, entry.get_text()) if r == "send" else None)
        dlg.present()

    # ---- apps outside the catalog ----

    STATUS = {"pending": _("waiting for IT"), "approved": _("approved"),
              "denied": _("declined")}

    def _my_requests(self, reqs):
        if not reqs:
            return None
        group = Adw.PreferencesGroup(title=_("My Requests"),
                                     description=_("Apps you asked IT to add. Approved apps appear in the catalog above."),
                                     margin_start=24, margin_end=24, margin_bottom=24)
        for r in reqs:
            row = Adw.ActionRow(title=GLib.markup_escape_text(r.get("name") or r.get("flatpak", "")),
                                subtitle=GLib.markup_escape_text(r.get("flatpak", "")))
            st = r.get("status", "pending")
            css = {"approved": "success", "denied": "error"}.get(st, "dim-label")
            row.add_suffix(Gtk.Label(label=self.STATUS.get(st, st), css_classes=[css]))
            group.add(row)
        return group

    def _other_app_dialog(self):
        win = Adw.Window(transient_for=self, modal=True, default_width=560, default_height=620,
                         title=_("Request Another App"))
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12, margin_start=18, margin_end=18)
        body.append(Gtk.Label(label=_("Search Flathub. IT decides on your request: either you may install the app, or it is installed for you."),
                              wrap=True, xalign=0, css_classes=["dim-label"]))
        entry = Gtk.SearchEntry(placeholder_text=_("e.g. Krita, Obsidian, Zotero"), search_delay=600)
        body.append(entry)
        results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"], valign=Gtk.Align.START)
        stack = Gtk.Stack(vexpand=True)
        stack.add_named(Adw.StatusPage(icon_name="system-search-symbolic", title=_("Find an App")), "empty")
        stack.add_named(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, width_request=32), "busy")
        stack.add_named(Gtk.ScrolledWindow(child=results), "results")
        none = Adw.StatusPage(icon_name="edit-find-symbolic", title=_("Nothing Found"))
        stack.add_named(none, "none")
        body.append(stack)
        view.set_content(body)
        win.set_content(view)

        def show(res, err, query):
            if query != entry.get_text().strip():
                return False  # an older search
            while results.get_first_child():
                results.remove(results.get_first_child())
            if err or not res.get("ok"):
                none.set_description(tr_data((res or {}).get("error")) or _("The agent does not respond."))
                stack.set_visible_child_name("none")
                return False
            hits = res.get("hits") or []
            for h in hits:
                row = Adw.ActionRow(title=GLib.markup_escape_text(h.get("name", "")),
                                    subtitle=GLib.markup_escape_text(h.get("summary", "")), subtitle_lines=2)
                img = Gtk.Image.new_from_file(h["icon"]) if h.get("icon") and os.path.isfile(h["icon"]) else Gtk.Image(icon_name="application-x-executable")
                img.set_pixel_size(40)
                row.add_prefix(img)
                ask = Gtk.Button(label=_("Request"), valign=Gtk.Align.CENTER, css_classes=["pill"])
                ask.connect("clicked", lambda _b, h=h: self._request_new_dialog(win, h))
                row.add_suffix(ask)
                results.append(row)
            none.set_description(_("Apps already in the catalog are not listed here."))
            stack.set_visible_child_name("results" if hits else "none")
            return False

        def search(e):
            q = e.get_text().strip()
            if len(q) < 2:
                stack.set_visible_child_name("empty")
                return
            stack.set_visible_child_name("busy")
            in_background(lambda: agent({"op": "search", "query": q}, timeout=60), lambda res, err: show(res, err, q))

        entry.connect("search-changed", search)
        win.present()

    def _request_new_dialog(self, parent, hit):
        dlg = Adw.MessageDialog(transient_for=parent, heading=_("Request %s") % hit.get("name", ""),
                                body=_("IT reviews the app and adds it to the catalog for you."))
        entry = Gtk.Entry(placeholder_text=_("Why do you need it? (optional)"))
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", _("Cancel"))
        dlg.add_response("send", _("Send Request"))
        dlg.set_response_appearance("send", Adw.ResponseAppearance.SUGGESTED)

        def done(res, err):
            if err or not res.get("ok"):
                self.toast(tr_data((res or {}).get("error")) or str(err))
            else:
                self.toast(_("Request sent to IT"))
                parent.close()
            self._load_catalog()
            return False

        def respond(_d, r):
            if r == "send":
                req = {"op": "app-request-new", "flatpak": hit.get("id"), "remote": hit.get("remote", ""),
                       "name": hit.get("name", ""), "note": entry.get_text()}
                in_background(lambda: agent(req, timeout=20), done)

        dlg.connect("response", respond)
        dlg.present()

    # ---- actions ----

    def _sync(self, button):
        button.set_sensitive(False)

        def done(res, err):
            button.set_sensitive(True)
            if err or not res.get("ok"):
                self.toast(tr_data((res or {}).get("error")) or str(err))
            else:
                self.toast(_("Sync started"))
                GLib.timeout_add_seconds(15, lambda: (self.refresh(), False)[1])
            return False

        in_background(lambda: agent({"op": "sync"}, timeout=20), done)

    def _escrow(self, button, uuid, entry):
        pw = entry.get_text()
        if not pw:
            return
        button.set_sensitive(False)
        entry.set_sensitive(False)

        def done(res, err):
            entry.set_text("")
            entry.set_sensitive(True)
            button.set_sensitive(True)
            if err:
                self.toast(_("The agent does not respond."))
            elif res.get("ok"):
                self.toast(_("Recovery key stored. Your passphrase is unchanged."))
                self.refresh()
            elif "too many" in res.get("error", ""):
                self.toast(_("Too many attempts. Try again later."))
            else:
                self.toast(_("The passphrase was not accepted."))
            return False

        in_background(lambda: agent({"op": "escrow", "uuid": uuid, "passphrase": pw}), done)


class DialogApp(Adw.Application):
    """One dialog for the tray helper (limdm-desktop): the spec comes as JSON
    on stdin, a password goes to stdout. Exit code 0 accept, 1 cancel."""

    def __init__(self, spec):
        super().__init__(application_id=APP_ID + ".Dialog", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.spec, self.code = spec, 1

    def do_activate(self):
        sp = self.spec
        kind = sp.get("kind", "message")
        dlg = Adw.MessageDialog(heading=sp.get("heading", ""), body=sp.get("body", ""))
        dlg.set_title(sp.get("title", ""))
        self.add_window(dlg)
        extra = None
        if kind == "password":
            extra = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True, placeholder_text=sp.get("label", ""))
        elif sp.get("rows") or sp.get("pre"):
            extra = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            if sp.get("rows"):
                rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
                for label, value in sp["rows"]:
                    row = Adw.ActionRow(title=GLib.markup_escape_text(label), subtitle=GLib.markup_escape_text(value or "–"),
                                        css_classes=["property"], subtitle_selectable=True)
                    rows.append(row)
                extra.append(rows)
            if sp.get("pre"):
                view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8,
                                    left_margin=8, right_margin=8)
                view.get_buffer().set_text(sp["pre"])
                extra.append(Gtk.ScrolledWindow(child=view, min_content_height=240, css_classes=["card"]))
            dlg.set_default_size(520, -1)
        if extra is not None:
            dlg.set_extra_child(extra)
        if kind in ("ask", "password"):
            dlg.add_response("cancel", sp.get("no") or _("Cancel"))
            dlg.add_response("ok", sp.get("yes") or _("OK"))
            dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("ok")
            dlg.set_close_response("cancel")
        else:
            dlg.add_response("ok", _("Close"))

        def respond(_d, r):
            if r == "ok":
                self.code = 0
                if kind == "password":
                    sys.stdout.write(extra.get_text() + "\n")
                    sys.stdout.flush()
            self.quit()

        dlg.connect("response", respond)
        dlg.present()


class App(Adw.Application):
    def __init__(self, start):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start = start

    def do_activate(self):
        win = self.props.active_window or Window(self, self.start)
        win.present()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--dialog":
        try:
            spec = json.load(sys.stdin)
        except ValueError:
            sys.exit(2)
        app = DialogApp(spec)
        app.run([sys.argv[0]])
        sys.exit(app.code)
    start = "overview"
    if len(sys.argv) > 2 and sys.argv[1] == "--page":
        start = sys.argv[2]
    sys.exit(App(start).run([sys.argv[0]]))
