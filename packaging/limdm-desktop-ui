SOCKET = "/run/limdm/agent.sock"
APP_ID = "io.github.maltekiefer.LiMDM"


def _german():
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(k)
        if v:
            return v.startswith("de")
    try:
        with open("/etc/locale.conf") as f:
            for line in f:
                if line.startswith("LANG="):
                    return line.split("=", 1)[1].strip().strip("\"'").startswith("de")
    except OSError:
        pass
    return False


DE = _german()


def tr(en, de):
    return de if DE else en


def agent(req, timeout=120):
    """One request on the agent socket: a JSON line out, a JSON line back."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(SOCKET)
        s.sendall(json.dumps(req).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf or b"{}")


def in_background(work, done):
    """Run work() off the UI thread and hand its result (or error) to done()."""

    def run():
        try:
            res, err = work(), None
        except Exception as e:  # shown to the user, never raised in GTK
            res, err = None, e
        GLib.idle_add(done, res, err)

    threading.Thread(target=run, daemon=True).start()


def when(ts):
    if not ts:
        return tr("never", "nie")
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return ts
    return t.strftime("%Y-%m-%d %H:%M")


