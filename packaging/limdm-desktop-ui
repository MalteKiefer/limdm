LANGUAGES = ("de", "fr", "es", "it", "ru")  # besides English, the msgids


def _language():
    """The session's language like gettext picks it (LC_ALL, LC_MESSAGES,
    LANG, the system locale, then LANGUAGE unless the locale is C); English
    when none is supported."""
    def base(v):
        for sep in "_.@-":
            v = v.split(sep)[0]
        return v.strip().lower()

    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    if not loc:
        for path in ("/etc/locale.conf", "/etc/default/locale"):
            try:
                with open(path) as f:
                    loc = next((ln.split("=", 1)[1].strip().strip("\"'") for ln in f if ln.startswith("LANG=")), "")
            except OSError:
                continue
            if loc:
                break
    if base(loc) not in ("c", "posix"):
        for lang in os.environ.get("LANGUAGE", "").split(":"):
            if base(lang) in LANGUAGES or base(lang) == "en":
                return base(lang)
    return base(loc) if base(loc) in LANGUAGES else "en"


def _po_to_mo(text):
    """Compile a .po file (msgid, msgid_plural, msgstr, msgstr[n]) to .mo
    bytes, so gettext reads it without msgfmt at build time."""
    entries, cur, last = {}, None, None

    def flush():
        if cur and "msgstr" in cur:
            key = cur["msgid"] + ("\0" + cur["msgid_plural"] if "msgid_plural" in cur else "")
            entries[key] = "\0".join(cur["msgstr"])

    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith('"'):  # continuation of the previous string
            if last == "msgstr":
                cur["msgstr"][-1] += ast.literal_eval(line)
            else:
                cur[last] += ast.literal_eval(line)
            continue
        kw, _, rest = line.partition(" ")
        if kw == "msgid":
            flush()
            cur = {}
        if kw.startswith("msgstr"):
            cur.setdefault("msgstr", []).append(ast.literal_eval(rest))
            last = "msgstr"
        else:
            cur[kw] = ast.literal_eval(rest)
            last = kw
    flush()
    keys = sorted(entries)
    ids = [k.encode() for k in keys]
    strs = [entries[k].encode() for k in keys]
    n = len(keys)
    off = 28 + 16 * n
    table_ids, table_strs, data = [], [], b""
    for b in ids:
        table_ids += [len(b), off + len(data)]
        data += b + b"\0"
    for b in strs:
        table_strs += [len(b), off + len(data)]
        data += b + b"\0"
    head = struct.pack("<7I", 0x950412DE, 0, n, 28, 28 + 8 * n, 0, 0)
    return head + struct.pack(f"<{4 * n}I", *table_ids, *table_strs) + data


def _translations():
    """gettext translations from <lang>.po next to this script (source tree)
    or in /usr/share/limdm/locale (packages); English without one."""
    lang = _language()
    if lang == "en":
        return gettext.NullTranslations()
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "locale")
    for d in (here, "/usr/share/limdm/locale"):
        try:
            with open(os.path.join(d, lang + ".po"), encoding="utf-8") as f:
                return gettext.GNUTranslations(io.BytesIO(_po_to_mo(f.read())))
        except (OSError, ValueError, SyntaxError):
            continue
    return gettext.NullTranslations()


_T = _translations()
_ = _T.gettext
ngettext = _T.ngettext


def tr_data(text):
    """Translate a text the agent sends (a check title, an error) when the
    catalog knows it; anything else, such as titles set by IT, as is."""
    return _(text) if text else text


def agent(req, timeout=120):
    """One request on the agent socket: a JSON line out, a JSON line back."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(SOCKET)
        s.sendall(json.dumps(req).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf or b"{}")


def in_background(work, done):
    """Run work() off the UI thread and hand its result (or error) to done()."""

    def run():
        try:
            res, err = work(), None
        except Exception as e:  # shown to the user, never raised in GTK
            res, err = None, e
        GLib.idle_add(done, res, err)

    threading.Thread(target=run, daemon=True).start()


def when(ts):
    if not ts:
        return _("never")
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return ts
    return t.strftime("%Y-%m-%d %H:%M")


