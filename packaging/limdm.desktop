[Desktop Entry]
Type=Application
Name=LiMDM
GenericName=Device Management
GenericName[de]=Geräteverwaltung
GenericName[fr]=Gestion des appareils
GenericName[es]=Gestión de dispositivos
GenericName[it]=Gestione dei dispositivi
GenericName[ru]=Управление устройствами
Comment=State of this managed device: compliance, disk encryption, agent log
Comment[de]=Zustand dieses verwalteten Geräts: Compliance, Verschlüsselung, Agent Protokoll
Comment[fr]=État de cet appareil géré : conformité, chiffrement du disque, journal de l'agent
Comment[es]=Estado de este dispositivo administrado: cumplimiento, cifrado de disco, registro del agente
Comment[it]=Stato di questo dispositivo gestito: conformità, cifratura del disco, registro dell'agente
Comment[ru]=Состояние этого управляемого устройства: соответствие, шифрование диска, журнал агента
Exec=/usr/lib/limdm/limdm-desktop-ui
Icon=limdm
Categories=System;Settings;Security;
Keywords=MDM;compliance;security;encryption;
StartupNotify=true
Terminal=false
